<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetodesktop.controller.ControllerHelpCenter">
    <children>
        <Label layoutX="30.0" layoutY="20.0" text="Central de Ajuda &amp; Denúncias">
            <font><Font name="System Bold" size="22.0" /></font>
        </Label>

        <TableView fx:id="tabelaTickets" layoutX="30.0" layoutY="60.0" prefHeight="160.0" prefWidth="640.0">
            <columns>
                <TableColumn fx:id="colProtocolo" prefWidth="90.0" text="Protocolo" />
                <TableColumn fx:id="colUsuario" prefWidth="120.0" text="Usuário" />
                <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="colDescricao" prefWidth="158.0" text="Descrição" />
            </columns>
        </TableView>

        <Label layoutX="30.0" layoutY="235.0" text="Detalhes / Responder Ticket:">
            <font><Font name="System Bold" size="13.0" /></font>
        </Label>

        <TextArea fx:id="taDescricao" editable="false" layoutX="30.0" layoutY="260.0" prefHeight="80.0" prefWidth="640.0" promptText="Selecione um ticket na tabela acima para ver os detalhes..." wrapText="true" />

        <Label layoutX="30.0" layoutY="355.0" text="Status do Ticket:" />
        <ComboBox fx:id="cbStatus" layoutX="130.0" layoutY="350.0" prefWidth="180.0" />

        <Label layoutX="30.0" layoutY="390.0" text="Resposta ao Usuário:" />
        <TextArea fx:id="taResposta" layoutX="30.0" layoutY="410.0" prefHeight="70.0" prefWidth="640.0" promptText="Digite a resposta do suporte..." wrapText="true" />

        <Button layoutX="520.0" layoutY="490.0" mnemonicParsing="false" onAction="#handleSalvarAlteracoes" style="-fx-background-color: #2eaf5d;" text="💾 Salvar / Atualizar" textFill="WHITE">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>

        <Button layoutX="30.0" layoutY="490.0" mnemonicParsing="false" onAction="#handleVoltar" text="⬅ Voltar ao Menu" />
    </children>
</AnchorPane>