<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane prefHeight="590.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetodesktop.controller.ControllerRelatorioUsuario">
    <children>
        <Label fx:id="lblNome" layoutX="20" layoutY="18" text="RELATÓRIO DE USUÁRIO" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #69a8dc;"/>
        <AreaChart fx:id="customerChart" layoutX="20" layoutY="65" prefHeight="320" prefWidth="710">
            <xAxis>
                <CategoryAxis label="MESES"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="INDICADOR"/>
            </yAxis>
        </AreaChart>
        <HBox layoutX="20" layoutY="405" spacing="10">
            <children>
                <Button onAction="#agua" text="ÁGUA" prefWidth="100"/>
                <Button onAction="#sono" text="SONO" prefWidth="100"/>
                <Button onAction="#exercicio" text="MOVIMENTO" prefWidth="120"/>
            </children>
        </HBox>
        <Label fx:id="lblMedia" layoutX="20" layoutY="470" prefWidth="690" prefHeight="50" style="-fx-font-size: 22px;"/>
        <Button layoutX="20" layoutY="540" onAction="#handleVoltar" text="⬅ Voltar"/>
    </children>
</AnchorPane>
