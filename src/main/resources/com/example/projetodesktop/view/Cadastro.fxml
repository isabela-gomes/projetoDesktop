<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetodesktop.controller.ControllerCadastro">
   <children>
      <Button fx:id="BttEntrar" layoutX="206.0" layoutY="280.0" mnemonicParsing="false" onAction="#handleCadastrar" prefHeight="25.0" prefWidth="191.0" text="Cadastrar" textOverrun="CLIP" wrapText="true">
         <textFill>
            <LinearGradient endX="1.0" startY="1.0">
               <stops>
                  <Stop><color><Color green="0.41754385828971863" blue="0.7368420958518982" /></color></Stop>
                  <Stop offset="1.0"><color><Color red="1.0" green="1.0" blue="1.0" /></color></Stop>
               </stops>
            </LinearGradient>
         </textFill>
         <font>
            <Font name="System Bold Italic" size="21.0" />
         </font>
      </Button>

      <Label layoutX="206.0" layoutY="80.0" prefHeight="19.0" prefWidth="191.0" text="Cadastre e forneça uma senha!">
         <font>
            <Font name="NSimSun" size="13.0" />
         </font>
      </Label>

      <Label layoutX="190.0" layoutY="115.0" text="Cadastro">
         <textFill>
            <LinearGradient endX="1.0" endY="1.0">
               <stops>
                  <Stop><color><Color green="0.41754385828971863" blue="0.7368420958518982" /></color></Stop>
                  <Stop offset="1.0"><color><Color red="0.2823529541492462" green="0.7019608020782471" blue="1.0" /></color></Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
      <TextField fx:id="Tfcadastro" layoutX="275.0" layoutY="111.0" />

      <Label layoutX="190.0" layoutY="150.0" text="Senha">
         <textFill>
            <LinearGradient endX="1.0" endY="1.0">
               <stops>
                  <Stop><color><Color green="0.41754385828971863" blue="0.7368420958518982" /></color></Stop>
                  <Stop offset="1.0"><color><Color red="0.2823529541492462" green="0.7019608020782471" blue="1.0" /></color></Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
      <PasswordField fx:id="Tfsenha" layoutX="275.0" layoutY="146.0" />
      <TextField fx:id="TfsenhaTexto" layoutX="275.0" layoutY="146.0" visible="false" />
      <Button fx:id="BtnVerSenha" layoutX="430.0" layoutY="146.0" onAction="#handleToggleMostrarSenha" text="👁" />

      <Label layoutX="160.0" layoutY="185.0" text="Confirmar Senha">
         <textFill>
            <LinearGradient endX="1.0" endY="1.0">
               <stops>
                  <Stop><color><Color green="0.41754385828971863" blue="0.7368420958518982" /></color></Stop>
                  <Stop offset="1.0"><color><Color red="0.2823529541492462" green="0.7019608020782471" blue="1.0" /></color></Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
      <PasswordField fx:id="Tfconfirmarsenha" layoutX="275.0" layoutY="181.0" />
      <TextField fx:id="TfconfirmarsenhaTexto" layoutX="275.0" layoutY="181.0" visible="false" />
      <Button fx:id="BtnVerConfirmarSenha" layoutX="430.0" layoutY="181.0" onAction="#handleToggleMostrarConfirmarSenha" text="👁" />

      <Hyperlink fx:id="Hplogin" layoutX="255.0" layoutY="235.0" onAction="#handleIrParaLogin" text="Já tem login? " />
      <Text layoutX="190.0" layoutY="71.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Olá! Bem vindo!">
         <font>
            <Font size="34.0" />
         </font>
         <fill>
            <LinearGradient endX="0.6682464454976303" endY="0.943127962085308" startY="0.46445497630331756">
               <stops>
                  <Stop>
                     <color>
                        <Color green="0.4156862795352936" blue="0.7372549176216125" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="0.6315789222717285" green="0.6315789222717285" blue="0.6315789222717285" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </fill>
      </Text>
   </children>
</AnchorPane>
