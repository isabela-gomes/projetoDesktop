<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetodesktop.controller.ControllerLogin">
   <children>
      <Button fx:id="BttEntrar" layoutX="205.0" layoutY="250.0" mnemonicParsing="false" onAction="#handleEntrar" prefHeight="25.0" prefWidth="191.0" text="ENTRAR">
         <font>
            <Font name="System Bold Italic" size="21.0" />
         </font>
         <textFill>
            <LinearGradient endX="1.0" startY="1.0">
               <stops>
                  <Stop><color><Color green="0.41754385828971863" blue="0.7368420958518982" /></color></Stop>
                  <Stop offset="1.0"><color><Color red="1.0" green="1.0" blue="1.0" /></color></Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Button>

      <Label layoutX="198.0" layoutY="105.0" text="Digite seu login com sua senha!">
         <font>
            <Font name="NSimSun" size="13.0" />
         </font>
      </Label>

      <Label layoutX="200.0" layoutY="140.0" text="Login">
         <textFill>
            <LinearGradient endX="1.0" endY="1.0">
               <stops>
                  <Stop><color><Color green="0.41754385828971863" blue="0.7368420958518982" /></color></Stop>
                  <Stop offset="1.0"><color><Color red="0.2823529541492462" green="0.7019608020782471" blue="1.0" /></color></Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
      <TextField fx:id="TfLogin" layoutX="246.0" layoutY="136.0" />


      <Label layoutX="200.0" layoutY="175.0" text="Senha">
         <textFill>
            <LinearGradient endX="1.0" endY="1.0">
               <stops>
                  <Stop><color><Color green="0.41754385828971863" blue="0.7368420958518982" /></color></Stop>
                  <Stop offset="1.0"><color><Color red="0.2823529541492462" green="0.7019608020782471" blue="1.0" /></color></Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
      <PasswordField fx:id="Tfsenha" layoutX="246.0" layoutY="171.0" />
      <TextField fx:id="TfsenhaTexto" layoutX="246.0" layoutY="171.0" visible="false" />
      <Button fx:id="BtnVerSenha" layoutX="401.0" layoutY="171.0" onAction="#handleToggleMostrarSenha" text="👁" />

      <Hyperlink fx:id="Hpcadastro" layoutX="229.0" layoutY="210.0" onAction="#handleIrParaCadastro" text="Não tem login? Cadastre!" />
      <Text layoutX="201.0" layoutY="71.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Olá! Bem vindo!">
         <font>
            <Font size="34.0" />
         </font>
         <fill>
            <LinearGradient endX="0.6682464454976303" endY="0.943127962085308" startY="0.46445497630331756">
               <stops>
                  <Stop>
                     <color>
                        <Color green="0.4156862795352936" blue="0.7372549176216125" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="0.6315789222717285" green="0.6315789222717285" blue="0.6315789222717285" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </fill>
      </Text>
   </children>
</AnchorPane>
