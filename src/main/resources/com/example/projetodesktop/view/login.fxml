<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="440.0" prefWidth="620.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetodesktop.controller.ControllerLogin">
 <children>
  <TextField fx:id="TfLogin" layoutX="246.0" layoutY="156.0" prefWidth="190.0" promptText="Login"/>
  <PasswordField fx:id="Tfsenha" layoutX="246.0" layoutY="196.0" prefWidth="155.0" promptText="Senha"/>
  <TextField fx:id="TfsenhaTexto" layoutX="246.0" layoutY="196.0" prefWidth="155.0" promptText="Senha" visible="false" managed="false"/>
  <Button fx:id="BtnVerSenha" layoutX="407.0" layoutY="196.0" onAction="#handleToggleMostrarSenha" text="👁"/>
  <Button layoutX="214.0" layoutY="278.0" prefWidth="200.0" prefHeight="36.0" onAction="#handleEntrar" text="ENTRAR" style="-fx-background-color: #69a8dc; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
  <Hyperlink layoutX="232.0" layoutY="325.0" onAction="#handleIrParaCadastro" text="Não tem login? Cadastre!"/>
  <Label layoutX="202.0" layoutY="88.0" text="Olá! Bem vindo!" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #6aa8d8;"/>
  <Label layoutX="198.0" layoutY="127.0" text="Digite seu login com sua senha!"/>
  <Label layoutX="198.0" layoutY="159.0" text="Login"/><Label layoutX="198.0" layoutY="199.0" text="Senha"/>
 </children>
</AnchorPane>
