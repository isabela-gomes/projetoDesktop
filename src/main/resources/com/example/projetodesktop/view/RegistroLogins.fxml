<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="816.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetodesktop.controller.ControllerRegistroLogins">
    <children>
        <Label layoutX="30.0" layoutY="20.0" text="Gerenciamento de Usuários">
            <font><Font name="System Bold" size="22.0" /></font>
         <textFill>
            <LinearGradient endX="0.6113744075829384" endY="0.5023696682464456" startY="0.7630331753554502">
               <stops>
                  <Stop>
                     <color>
                        <Color red="0.4152046740055084" green="0.6401072144508362" blue="0.9342105388641357" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="0.6447368264198303" green="0.6447368264198303" blue="0.6447368264198303" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </textFill>
        </Label>

        <TableView fx:id="tabelaUsuarios" layoutX="30.0" layoutY="65.0" prefHeight="230.0" prefWidth="774.0">
            <columns>
                <TableColumn fx:id="colUsuario" prefWidth="220.0" text="Usuário / Login" />
                <TableColumn fx:id="colStatus" prefWidth="250.0" text="Status" />
                <TableColumn fx:id="colDataCadastro" prefWidth="148.0" text="Data de Cadastro" />
            <TableColumn fx:id="colIdadeuser" prefWidth="148.0" text="Idade do Usuario" />
            </columns>
        </TableView>

        <Label layoutX="30.0" layoutY="310.0" text="Ações do Usuário Selecionado:">
            <font><Font name="System Bold" size="13.0" /></font>
        </Label>

        <Button layoutX="30.0" layoutY="340.0" mnemonicParsing="false" onAction="#handleBanirUsuario" style="-fx-background-color: #ff4d4d;" text="🚫 Banir Usuário" textFill="WHITE">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>

        <Button layoutX="160.0" layoutY="340.0" mnemonicParsing="false" onAction="#handleDesbanirUsuario" style="-fx-background-color: #2eaf5d;" text="✅ Desbanir Usuário" textFill="WHITE">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>

        <Button layoutX="310.0" layoutY="340.0" mnemonicParsing="false" onAction="#handleExcluirUsuario" style="-fx-background-color: #333333;" text="🗑 Excluir Usuário" textFill="WHITE">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>

        <Button layoutX="30.0" layoutY="395.0" mnemonicParsing="false" onAction="#handleVoltar" text="⬅ Voltar ao Menu" />
    </children>
</AnchorPane>
