<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane prefHeight="560.0" prefWidth="820.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetodesktop.controller.ControllerListarClientes">
    <children>
        <Label layoutX="24" layoutY="20" text="Usuários / Clientes" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #69a8dc;"/>
        <TableView fx:id="tbclientes" layoutX="24" layoutY="70" prefWidth="770" prefHeight="400">
            <columns>
                <TableColumn fx:id="colnome" text="USUÁRIO / LOGIN" prefWidth="240"/>
                <TableColumn fx:id="colstatus" text="STATUS" prefWidth="190"/>
                <TableColumn fx:id="coldata" text="DATA DE CADASTRO" prefWidth="200"/>
                <TableColumn fx:id="colidade" text="IDADE" prefWidth="120"/>
            </columns>
        </TableView>
        <Button layoutX="24" layoutY="490" onAction="#Relatorio" text="RELATÓRIO DO USUÁRIO" style="-fx-background-color: #69a8dc; -fx-text-fill: white;"/>
        <Button layoutX="240" layoutY="490" onAction="#handleVoltar" text="⬅ Voltar ao Menu"/>
    </children>
</AnchorPane>
