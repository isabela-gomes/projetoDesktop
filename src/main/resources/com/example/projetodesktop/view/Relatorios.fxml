<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane prefHeight="560.0" prefWidth="820.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetodesktop.controller.ControllerRelatorios">
    <children>
        <Label layoutX="20" layoutY="18" text="Relatórios de Saúde &amp; Triagem (Quiz)" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #69a8dc;"/>
        <BarChart fx:id="graficoDisturbios" layoutX="25" layoutY="75" prefHeight="390" prefWidth="555" animated="false">
            <xAxis>
                <CategoryAxis label="Tema"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Escala de respostas" lowerBound="1" upperBound="5" tickUnit="1" minorTickVisible="false"/>
            </yAxis>
        </BarChart>
        <VBox layoutX="600" layoutY="112" prefWidth="195" prefHeight="330" spacing="0" alignment="CENTER_LEFT">
            <children>
                <Label text="5  😁  Muito bom" prefHeight="66" alignment="CENTER_LEFT" style="-fx-font-size: 16px;"/>
                <Label text="4  🙂  Bom" prefHeight="66" alignment="CENTER_LEFT" style="-fx-font-size: 16px;"/>
                <Label text="3  😐  Regular" prefHeight="66" alignment="CENTER_LEFT" style="-fx-font-size: 16px;"/>
                <Label text="2  😕  Ruim" prefHeight="66" alignment="CENTER_LEFT" style="-fx-font-size: 16px;"/>
                <Label text="1  🙁  Muito ruim" prefHeight="66" alignment="CENTER_LEFT" style="-fx-font-size: 16px;"/>
            </children>
        </VBox>
        <Button layoutX="20" layoutY="515" onAction="#handleVoltar" text="⬅ Voltar ao Menu"/>
    </children>
</AnchorPane>
