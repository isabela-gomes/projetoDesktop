<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane prefHeight="650.0" prefWidth="820.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetodesktop.controller.ControllerReceitas">
 <children>
  <Label layoutX="24" layoutY="20" text="Cadastro de Receitas" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #69a8dc;"/>
  <Label layoutX="28" layoutY="75" text="Nome"/><TextField fx:id="txtNome" layoutX="145" layoutY="70" prefWidth="300"/>
  <Label layoutX="28" layoutY="120" text="Receita / Preparo"/><TextArea fx:id="txtReceita" layoutX="145" layoutY="115" prefWidth="620" prefHeight="85" wrapText="true"/>
  <Label layoutX="28" layoutY="220" text="Alérgicos"/><TextField fx:id="txtAlergicos" layoutX="145" layoutY="215" prefWidth="620" promptText="Informe ingredientes que podem causar alergias"/>
  <Label layoutX="28" layoutY="265" text="Informação nutricional"/><TextField fx:id="txtTabelaNutricional" layoutX="190" layoutY="260" prefWidth="575"/>
  <Button layoutX="145" layoutY="305" onAction="#selecionarArquivos" text="Adicionar imagem"/><Label fx:id="lblArquivo" layoutX="270" layoutY="310" text="Nenhuma imagem selecionada"/>
  <Button layoutX="145" layoutY="350" onAction="#RegistrarReceitas" text="Cadastrar receita" style="-fx-background-color: #69a8dc; -fx-text-fill: white;"/><Button layoutX="285" layoutY="350" onAction="#ExcluirReceita" text="Excluir selecionada"/>
  <Label layoutX="28" layoutY="400" text="Receitas cadastradas" style="-fx-font-weight: bold;"/>
  <TableView fx:id="tabelaReceitas" layoutX="28" layoutY="425" prefWidth="765" prefHeight="165"><columns><TableColumn fx:id="colNome" text="Nome" prefWidth="180"/><TableColumn fx:id="colReceita" text="Preparo" prefWidth="340"/><TableColumn fx:id="colAlergicos" text="Alérgicos" prefWidth="230"/></columns></TableView>
  <Button layoutX="28" layoutY="610" onAction="#handleVoltar" text="⬅ Voltar ao Menu"/>
 </children>
</AnchorPane>
